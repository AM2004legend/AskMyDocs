# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://askmydocs:askmydocs@localhost:5433/askmydocs

# --- Primary LLM: Gemini (free tier, OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
# Model names change often: check https://ai.google.dev/gemini-api/docs/models
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite

# --- Fallback LLM: Groq (used automatically when Gemini rate-limits) ---
# Get a key at https://console.groq.com/keys ; models: https://console.groq.com/docs/models
# Leave FALLBACK_LLM_API_KEY empty to disable the fallback.
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
# gpt-oss models "think" before answering; low effort leaves room in the reply for the actual answer
FALLBACK_LLM_REASONING_EFFORT=low

# Fully local alternative (no API at all): install Ollama and use
# LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2:3b

# Comma-separated model lists: each model has its OWN free quota (measured Oct 2026: Gemini free
# ~20 requests/day per model; Groq free ~1000 requests/day but 8000 tokens/minute). Chat answers
# try Gemini first; the document map (many calls) tries Groq first to save Gemini's quota.

# Seconds to wait between LLM calls while building the document map.
LLM_MIN_INTERVAL_SECONDS=6.5

# --- Sensitive mode (PII redaction) ---
# Encrypts the placeholder -> real value vault. Create one with:
#   python -c "from app.privacy.vault import generate_key; print(generate_key())"
# Keep it safe: if you lose it, answers for sensitive documents can't be restored.
PII_VAULT_KEY=

# --- Optional tuning (defaults live in app/config.py) ---
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MIN_VECTOR_SIMILARITY=0.25
# MAX_UPLOAD_MB=20
# OCR_ENABLED=true

# --- Streamlit UI ---
API_URL=http://localhost:8000
