# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://askmydocs:askmydocs@localhost:5433/askmydocs

# --- Primary LLM: Gemini (free tier, OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
# Model names change often: check https://ai.google.dev/gemini-api/docs/models
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# --- Fallback LLM: Groq (used automatically when Gemini rate-limits) ---
# Get a key at https://console.groq.com/keys ; models: https://console.groq.com/docs/models
# Leave FALLBACK_LLM_API_KEY empty to disable the fallback.
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=openai/gpt-oss-20b

# Fully local alternative (no API at all): install Ollama and use
# LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.2:3b

# Seconds to wait between LLM calls while building the document map.
# Gemini free tier is roughly 10 requests/minute, so ~6.5s keeps us under it.
LLM_MIN_INTERVAL_SECONDS=6.5

# --- Optional tuning (defaults live in app/config.py) ---
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MIN_VECTOR_SIMILARITY=0.25
# MAX_UPLOAD_MB=20
# OCR_ENABLED=true

# --- Streamlit UI ---
API_URL=http://localhost:8000
